# ==============================================================================
# Edufy Academy - Environment Variables Configuration
# ==============================================================================

# Port for Fullstack Node/Express Dev Server (Default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration (PostgreSQL Database & Auth)
# ------------------------------------------------------------------------------
# Project URL from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_URL="https://your-project.supabase.co"

# Public Anonymous API Key (Safe for frontend bundle)
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_ANON_KEY="your-anon-public-key"

# Secret Service Role Key (SERVER ONLY - NEVER EXPOSE TO FRONTEND)
# Used exclusively in server.ts for payment verification, admin overrides, and webhooks
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway Integration
# ------------------------------------------------------------------------------
# Razorpay Key ID (Client-side identifier for Razorpay Checkout modal)
RAZORPAY_KEY_ID="rzp_test_yourKeyId"

# Razorpay Key Secret (SERVER ONLY - NEVER EXPOSE TO FRONTEND)
# Used strictly in server.ts to cryptographically verify HMAC-SHA256 signatures
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Razorpay Webhook Secret (SERVER ONLY)
# Used to verify incoming event signatures from Razorpay webhooks
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 3. System Defaults
# ------------------------------------------------------------------------------
# Optional Gemini API key if AI assistance is enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Base Application URL
APP_URL="http://localhost:3000"
