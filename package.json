{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=server-dist/server.mjs",
    "start:prod": "node server-dist/server.mjs",
    "verify:prebuilt": "node scripts/verify-prebuilt.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server-dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/courseUtils.test.ts tests/backend.test.ts tests/pushLogic.test.ts tests/settings.test.ts tests/siteSettings.web.test.ts tests/smtp.test.ts tests/emailSystem.test.ts tests/cron.test.ts tests/localAddresses.web.test.ts tests/authLinks.web.test.ts tests/cloudinary.test.ts tests/cdnImage.web.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "razorpay": "^2.9.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
