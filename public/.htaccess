# Edufy Academy website: Hostinger (LiteSpeed / Apache) settings for https://edufyacademy.com
# Upload as ".htaccess" into public_html together with the contents of the website build.
# The API runs separately on https://api.edufyacademy.com (Hostinger Node.js app), so nothing here
# forwards /api: an /api path on this domain gets a plain 404 instead of the website page.

Options -Indexes
DirectoryIndex index.html
# Unknown addresses: real HTTP 404 with the app's "page not found" view (404.html is built by scripts/seo/prerender.ts)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let's Encrypt / domain verification files are always served as-is
  RewriteRule ^\.well-known/ - [L]

  # 1. HTTPS + canonical address: http://, www. → https://edufyacademy.com (one 301 redirect)
  #    Only enable after hPanel shows the SSL certificate as Active for both edufyacademy.com and www.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://edufyacademy.com%{REQUEST_URI} [L,R=301,NE]

  # 2. API paths never fall through to the website (the API lives on api.edufyacademy.com)
  RewriteRule ^api(/|$) - [R=404,L]

  # 2b. Old course addresses (/courses/<id>) → the course's readable address. Rules are written here by the
  #     build (scripts/seo/prerender.ts) from the published courses; keep the marker line below.
  # @EDUFY_COURSE_REDIRECTS

  # 3. SEO: public pages have a prerendered HTML file in /seo (title, description, canonical, Open Graph,
  #    structured data and readable content — built by scripts/seo/prerender.ts). The React app starts from it
  #    exactly as from index.html. When a page has no such file the normal app shell below is used.
  RewriteCond %{DOCUMENT_ROOT}/seo/index.html -f
  RewriteRule ^$ /seo/index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/seo/$1.html -f
  RewriteRule ^(.+?)/?$ /seo/$1.html [L]

  # 4. Addresses that are not a website page → HTTP 404 (served by 404.html, which loads the app's 404 view).
  #    Keep this list in line with the routes in src/App.tsx.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule !^(courses|categories|bundles|instructors|instructor|verify-certificate|about|contact|become-instructor|faq|blog|privacy|terms|refund|login|register|forgot-password|reset-password|auth|learn|student|admin)(/|$) - [R=404,L]

  # 5. Single-page app: every route that is not a real file or folder returns index.html,
  #    so refreshing /courses/abc, /student/courses or /admin/settings works.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Fingerprinted build files never change → cache for a year
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Always fetch the latest page shells, prerendered pages, sitemap and deployment settings
  <FilesMatch "(\.html|^config\.js|^sitemap\.xml|^robots\.txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
