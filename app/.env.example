# ---------------------------------------------------------------------------
# Edufy Academy student app — public configuration only.
# EXPO_PUBLIC_* values are bundled into the app. NEVER put a Supabase secret /
# service-role key or the Razorpay key secret here.
# ---------------------------------------------------------------------------

# Same Supabase project as the website (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the Edufy Express server (the one that serves /api/*).
# Android emulator → http://10.0.2.2:3000 · physical phone on Wi-Fi → http://<your-PC-LAN-IP>:3000
# Production → https://your-domain.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Public website address (used as the video player's page origin and for "open on web" links)
EXPO_PUBLIC_WEB_URL=https://edufyacademy.com
