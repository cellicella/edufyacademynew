# =============================================================================
# Edufy Academy WEBSITE (React + Vite): build-time PUBLIC settings
# Copy to ".env.production.local" in the project root before running "npm run build".
#
# Everything starting with VITE_ is copied INTO the website's JavaScript and can be
# read by anyone. NEVER put a secret key here (no service-role key, no Razorpay secret).
# =============================================================================

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (starts with sb_publishable_)
# (the legacy "anon public" key also works). This key is designed to be public.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL. Address of the Edufy API, ending in /api.
# Leave EMPTY when the Node.js app serves the website too (same address).
# You can also set this AFTER upload in dist/config.js (apiBaseUrl), with no rebuild needed.
# Example: https://api.your-domain.com/api
VITE_API_BASE_URL=

# OPTIONAL. Public website address used in email-verification links, e.g. https://your-domain.com
# Leave empty to use the address the visitor is on. Can also be set in dist/config.js (siteUrl).
VITE_SITE_URL=
