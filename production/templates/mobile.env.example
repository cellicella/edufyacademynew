# =============================================================================
# Edufy Academy STUDENT APP (Expo): PUBLIC configuration only
# Local development: copy to app/.env
# Store builds (preview/production): enter the SAME names in expo.dev →
#   your project → Project settings → Environment variables (environment "production"
#   and "preview", visibility "Plain text" or "Sensitive", never "Secret" for EXPO_PUBLIC_).
#
# EXPO_PUBLIC_ values are built into the app and can be read by anyone.
# NEVER put the Supabase service-role key or the Razorpay key secret here.
# =============================================================================

# Same Supabase project as the website
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Address of the Edufy Node.js server (WITHOUT /api at the end)
#   Production / preview builds: https://api.your-domain.com   (https is required; the build stops otherwise)
#   Local development only: http://10.0.2.2:3000 (emulator) or http://<PC-Wi-Fi-IP>:3000 (phone)
EXPO_PUBLIC_API_URL=https://api.your-domain.com

# Public website address (email-verification page, video player origin, "open on web" links)
EXPO_PUBLIC_WEB_URL=https://your-domain.com

# Expo project id (from "eas init"). Needed for push notifications. Not a secret.
EAS_PROJECT_ID=

# Google sign-in in the app uses the system browser and returns to edufyacademy://auth/callback.
# Add  edufyacademy://**  to Supabase → Authentication → URL Configuration → Redirect URLs.
# (Expo Go during development returns to exp://<PC-IP>:8081/--/auth/callback: add exp://** for local testing only.)
