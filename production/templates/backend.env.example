# =============================================================================
# Edufy Academy BACKEND (Express server: server-dist/server.mjs). SERVER-ONLY SECRETS
# Enter these in Hostinger → your Node.js web app → Environment variables
# (or a ".env" file next to package.json on a VPS). Never commit real values, and
# never put any of these in the website or mobile-app settings.
# =============================================================================

# Required in production: turns off test payments and serves the built website if dist/ is present
NODE_ENV=production
# Port to listen on. Hostinger sets PORT automatically; keep 3000 on a VPS behind Nginx.
PORT=3000

# Comma-separated website address(es) allowed to call the API from a browser
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ---- Admin settings: encryption key for credentials saved in the admin panel --
# SECRET. 32 random bytes in base64. Generate once and NEVER change it afterwards
# (changing it makes saved credentials unreadable; the server then falls back to the keys below).
#   PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   Linux/macOS: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# ---- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public key (same as the website's VITE_SUPABASE_PUBLISHABLE_KEY)
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# SECRET. Supabase → Project Settings → API Keys → "service_role" / secret key. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# ---- Razorpay ---------------------------------------------------------------
# Razorpay keys can ALSO be managed in Admin → Settings → Payment gateway (encrypted, tested
# before use). Keys saved there take priority; these environment keys are the fallback.
# Key Id is public (rzp_live_... in production, rzp_test_... for testing)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
# SECRET. Razorpay Dashboard → Account & Settings → API Keys. SERVER ONLY.
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET
# SECRET. Razorpay Dashboard → Webhooks → the secret you typed when creating the webhook
# Webhook URL: https://<api-address>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# ---- Adilo video hosting (lesson uploads / imports) -------------------------
ADILO_API_BASE_URL=https://adilo-api.bigcommand.com/v1
ADILO_PUBLIC_KEY=REPLACE_WITH_ADILO_PUBLIC_KEY
ADILO_SECRET_KEY=REPLACE_WITH_ADILO_SECRET_KEY
# Optional: existing Adilo project id (otherwise created once automatically)
ADILO_PROJECT_ID=

# ---- Transactional email -------------------------------------------------------
# Recommended: enter the SMTP account in Admin → Settings → SMTP & Email Configuration
# (encrypted, tested before activation). These variables are only a fallback when nothing is
# saved there. Values below are placeholders — use your provider's real host/port/login.
SMTP_HOST=
# 465 = SSL/TLS, 587 = STARTTLS
SMTP_PORT=587
# ssl | starttls
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Alternative to SMTP: resend or brevo HTTP API
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Background sender for queued emails. Set false only on extra server copies.
EMAIL_WORKER_ENABLED=true

# ---- Scheduled processing (required on Hostinger Node.js apps) ---------------------
# Hostinger cron job (every 5 minutes): curl -s "https://api.edufyacademy.com/api/internal/cron?key=<CRON_SECRET>"
# 32+ letters/digits, no % sign. PowerShell: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
CRON_SECRET=

# ---- Supabase Auth automation (optional) -----------------------------------------
# Personal access token (supabase.com/dashboard/account/tokens) so super admins can apply the
# Site URL, redirect URLs, Google provider and Send Email hook from Admin → Settings.
# Without it, the admin panel shows the exact values to enter in the Supabase dashboard.
SUPABASE_MANAGEMENT_TOKEN=
# Send Email hook secret (v1,whsec_…) when the hook is set up by hand in Supabase.
# Not needed when you use "Enable email hook" in Admin → Settings → Domain & Environment.
SUPABASE_AUTH_HOOK_SECRET=

# ---- Push notifications (Expo Push Service) ---------------------------------
# Optional but recommended: expo.dev → Account settings → Access tokens.
# Required only if "Enhanced push security" is turned on for the Expo project.
EXPO_ACCESS_TOKEN=
# Background sender for scheduled/automatic notifications. Set false only on extra server copies.
PUSH_WORKER_ENABLED=true
